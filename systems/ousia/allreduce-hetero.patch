+// Heterogeneous host mapping: one physical pinned allocation, mapped
+// separately by each participating runtime.  dev[0] is the local (this build)
+// runtime's device pointer, obtained at alloc time; dev[1] is the foreign
+// runtime's pointer, obtained via its register hook.  The physical pages are
+// shared, so a kernel on either runtime can read what the other wrote.  Only
+// used in heterogeneous mode (the foreign mapping must be unregistered via the
+// foreign hook before the local free).
+struct ggml_cuda_ar_hetero_mapping {
+    uint8_t * host = nullptr;   // physical pinned handle (local runtime)
+    void *    dev[2] = {};      // [0] = local runtime, [1] = foreign runtime
+
+    cudaError_t alloc(size_t bytes) {
+        cudaError_t rc = cudaHostAlloc(reinterpret_cast<void **>(&host), bytes,
+                                       cudaHostAllocPortable | cudaHostAllocMapped);
+        if (rc != cudaSuccess) {
+            host = nullptr;
+            return rc;
+        }
+        rc = cudaHostGetDevicePointer(&dev[0], host, 0);
+        if (rc != cudaSuccess) {
+            CUDA_CHECK(cudaFreeHost(host));
+            host = nullptr;
+            dev[0] = nullptr;
+            dev[1] = nullptr;
+        }
+        return rc;
+    }
+
+    void free() {
+        if (host) {
+            CUDA_CHECK(cudaFreeHost(host));
+            host = nullptr;
+            dev[0] = nullptr;
+            dev[1] = nullptr;
+        }
+    }
+};
