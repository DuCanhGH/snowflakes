+            p->foreign_cgraph->nodes[n_nodes++] = t_s;
+        } else {
+            // F32 wire, F32 accumulator: plain in-place add.
+            GGML_ASSERT(compute[F]);
+            make_result(t_add, GGML_OP_ADD, t_view, t_tmp);
+            n_nodes = 1;
+        }
+        p->foreign_cgraph->nodes[n_nodes++] = t_add;
+        p->foreign_cgraph->n_nodes = n_nodes;
+        if (ggml_backend_graph_compute_async(fb, p->foreign_cgraph) != GGML_STATUS_SUCCESS) {
+            GGML_LOG_ERROR("%s: foreign add graph failed\n", __func__);
+            return false;
+        }
+    }
+    ggml_backend_event_record(p->ev_f_ker[slot], fb);
+
+    p->host_large_read_done_valid = true;
+    p->dev_tmp_kernel_done_valid = true;
+
+    return true;
