+// ---------------------------------------------------------------------------
+// Heterogeneous chunked-mode hooks (see allreduce.cuh).  Each runs entirely in
+// the calling build's runtime: the stream, kernel, and every device pointer
+// are owned by this runtime.
+// ---------------------------------------------------------------------------
+void * ggml_cuda_ar_register_host(ggml_backend_t backend, void * host, size_t bytes) {
+    ggml_backend_cuda_context * ctx = static_cast<ggml_backend_cuda_context *>(backend->context);
+    ggml_cuda_set_device(ctx->device);
+
+    void * dev = nullptr;
+    // Portable only: the Mapped flag is CUDA-specific and has no HIP
+    // equivalent (hipHostRegister auto-maps).  If cudaHostGetDevicePointer
+    // can't translate the pointer the caller falls back to the copy engine.
+    cudaError_t rc = cudaHostRegister(host, bytes, cudaHostRegisterPortable);
+    if (rc != cudaSuccess) {
+        GGML_LOG_WARN("%s: cudaHostRegister(%zu B) failed: %s\n",
+                      __func__, bytes, cudaGetErrorString(rc));
+        (void) cudaGetLastError();
+        return nullptr;
+    }
+    rc = cudaHostGetDevicePointer(&dev, host, 0);
+    if (rc != cudaSuccess) {
+        GGML_LOG_WARN("%s: cudaHostGetDevicePointer failed: %s\n",
+                      __func__, cudaGetErrorString(rc));
+        (void) cudaGetLastError();
+        (void) cudaHostUnregister(host);
+        return nullptr;
+    }
+    return dev;
+}
+
+void ggml_cuda_ar_unregister_host(ggml_backend_t backend, void * host) {
+    GGML_UNUSED(backend);
+    if (cudaHostUnregister(host) != cudaSuccess) {
+        (void) cudaGetLastError();
+    }
+}
