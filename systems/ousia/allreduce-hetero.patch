+// ---------------------------------------------------------------------------
+// Heterogeneous chunked-mode self-test kernels.
+//
+// Probe cross-runtime visibility through mapped host memory before the chunked
+// path is enabled.  publish writes a constant payload then a flag (fenced);
+// consume spins on the flag, verifies the payload, and records a result code.
+// Both are single-threaded so no cross-thread reduction is needed.
+// ---------------------------------------------------------------------------
+static __global__ void ggml_cuda_ar_selftest_publish(uint8_t * payload, int * flag, int count, int token) {
+    for (int i = 0; i < count; ++i) {
+        payload[i] = (uint8_t) token;
+    }
+    __threadfence_system();
+    *(volatile int *)flag = token;
+}
+
+static __global__ void ggml_cuda_ar_selftest_consume(const uint8_t * payload, const int * flag,
+                                                     int * result, int count, int token) {
+    int spins = 0;
+    while (*(const volatile int *)flag != token) {
+        // Bounded so a broken mapping fails fast instead of tripping the
+        // driver's kernel-launch watchdog.
+        if (++spins > 20000000) {
+            *result = -1;
+            return;
+        }
+#ifdef GGML_USE_HIP
+        __builtin_amdgcn_s_sleep(4);
+#elif __CUDA_ARCH__ >= GGML_CUDA_CC_VOLTA
+        __nanosleep(100);
+#else
+        NO_DEVICE_CODE;
+#endif
+    }
+    __threadfence_system();
+    bool ok = true;
+    for (int i = 0; i < count; ++i) {
+        if (payload[i] != (uint8_t) token) {
+            ok = false;
+        }
+    }
+    *result = ok ? 1 : 0;
+}
