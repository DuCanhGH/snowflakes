+// ---------------------------------------------------------------------------
+// Heterogeneous copy-engine AllReduce (mixed CUDA + ROCm builds).
+//
+// The local rank (this build) keeps the two-stream design of the homogeneous
+// path.  The foreign rank has no same-runtime resources: its transfers and
+// kernels run on the foreign backend's own compute stream via the generic
+// backend API, and cross-rank sync is CPU-side (per-runtime events;
+// cross-runtime stream/event ops are not possible).
+//
+// Protocol per inner call (L = local rank, F = foreign rank, nbytes = wire
+// bytes, one call per copy_bytes-sized slice):
+//   stage 1:
+//     L: wait for local compute (ev.app); D2H src -> host_large[L] in
+//        chunks (cpy events).
+//     F: (if active) pre-cast F32 -> wire into foreign scratch (graph) when
+//        the wire is narrower, then D2H -> host_large[F]; (if inactive) CPU
+//        zeros host_large[F].  Record ev_f_d2h.
+//   barrier:
+//     CPU: wait ev_f_d2h, then wait L's last cpy event.
+//   stage 2:
+//     L: H2D host_large[F] -> dev_tmp[L]; add kernel on the local compute
+//        stream; record host_large_read_done[L], dev_tmp_kernel_done[L],
+//        ev.ker.
+//     F: H2D host_large[L] -> foreign scratch (or straight into the tensor
+//        when wire size == tensor size and F is inactive); add/cast graph
+//        into tensors[F]; record ev_f_read_done, ev_f_ker[slot].
+//
+// The foreign add/cast graph is bit-equivalent to ggml_cuda_ar_add_kernel:
+// both round the local value through the wire type and sum in F32.
+// ---------------------------------------------------------------------------
+
+static ggml_type ggml_cuda_ar_ggml_type_of(float) { return GGML_TYPE_F32; }
+static ggml_type ggml_cuda_ar_ggml_type_of(half) { return GGML_TYPE_F16; }
+static ggml_type ggml_cuda_ar_ggml_type_of(nv_bfloat16) { return GGML_TYPE_BF16; }
+
+// Reset a pre-allocated foreign tensor object before reuse.  The full memset
+// clears buffer/data/flags so ggml_backend_view_init() accepts the object on
+// every call (same pattern as the meta backend's aux nodes).
+static void ggml_cuda_ar_foreign_reset(ggml_tensor * t) {
+    memset(t, 0, sizeof(ggml_tensor));
+}
+
+template <typename T_src, typename T_dst>
+static bool ggml_cuda_ar_allreduce_copy_impl_hetero(
+        ggml_cuda_ar_pipeline * p,
+        ggml_backend_t        * backends,
+        ggml_tensor           ** tensors,
+        T_src * const           src_buf[GGML_CUDA_MAX_DEVICES],
+        T_dst * const           dst_buf[GGML_CUDA_MAX_DEVICES],
+        const bool              compute[GGML_CUDA_MAX_DEVICES],
+        int64_t                 ne,
+        size_t                  nbytes) {
+    GGML_ASSERT(p->n_devices == 2);
+    GGML_ASSERT(p->heterogeneous);
+    GGML_ASSERT(nbytes <= p->copy_bytes);
+    GGML_ASSERT(ne <= std::numeric_limits<int>::max());
+
+    const int L = 1 - p->foreign_rank;
+    const int F = p->foreign_rank;
+    ggml_backend_t fb = p->foreign_backend;
+
+    const ggml_type t_src = ggml_cuda_ar_ggml_type_of(T_src());
+    const ggml_type t_dst = ggml_cuda_ar_ggml_type_of(T_dst());
+
+    const size_t chunk_bytes = ggml_cuda_ar_chunk_bytes(p, nbytes);
+    GGML_ASSERT(chunk_bytes > 0);
+
+    const int slot = ggml_cuda_ar_acquire_slot(p).slot;
+    const size_t copy_chunks = (nbytes + chunk_bytes - 1) / chunk_bytes;
+    GGML_ASSERT(copy_chunks <= GGML_CUDA_AR_COPY_MAX_CHUNKS);
+
+    const size_t slice_off =
+        (size_t) (reinterpret_cast<const char *>(dst_buf[F]) - reinterpret_cast<const char *>(tensors[F]->data));
+
+    ggml_tensor * t_view = p->foreign_nodes[0];
+    ggml_tensor * t_tmp  = p->foreign_nodes[1];
+    ggml_tensor * t_a    = p->foreign_nodes[2];
+    ggml_tensor * t_b    = p->foreign_nodes[3];
+    ggml_tensor * t_c    = p->foreign_nodes[4];
+    ggml_tensor * t_s    = p->foreign_nodes[5];
+    ggml_tensor * t_add  = p->foreign_nodes[6];
+
+    auto align256 = [](size_t x) { return (x + 255) & ~size_t(255); };
+
+    // 1-D tensor over a slice of the foreign scratch.  ne[1..3] must stay 1:
+    // ggml_nelements (and the backend tensor get/set bounds asserts) multiply
+    // all four dims.
+    auto set_scratch = [&](ggml_tensor * t, ggml_type type, size_t off) {
+        ggml_cuda_ar_foreign_reset(t);
+        t->type = type;
+        t->ne[0] = ne;
+        t->ne[1] = t->ne[2] = t->ne[3] = 1;
+        t->nb[0] = ggml_type_size(type);
+        t->nb[1] = t->nb[0] * (size_t) ne;
+        t->nb[2] = t->nb[3] = t->nb[1];
+        t->data = p->foreign_scratch + off;
+        t->buffer = p->foreign_dev_buf;
+    };
+
+    // t_view: view of the actual foreign tensor (current slice).
+    ggml_cuda_ar_foreign_reset(t_view);
+    t_view->type = t_dst;
+    t_view->ne[0] = ne;
+    t_view->ne[1] = t_view->ne[2] = t_view->ne[3] = 1;
+    t_view->nb[0] = ggml_type_size(t_dst);
+    t_view->nb[1] = t_view->nb[0] * (size_t) ne;
+    t_view->nb[2] = t_view->nb[3] = t_view->nb[1];
+    t_view->data = dst_buf[F];
+    t_view->buffer = tensors[F]->buffer;
+
+    // Type conversion node writing into foreign scratch.  The CUDA backend
+    // implements GGML_OP_CPY (src[0] -> src[1]), not GGML_OP_CAST.
+    auto make_cast = [&](ggml_tensor * out, ggml_tensor * in, ggml_type out_type, size_t off) {
+        set_scratch(out, out_type, off);
+        out->op = GGML_OP_CPY;
+        out->src[0] = in;
+        out->src[1] = out;
+        out->flags |= GGML_TENSOR_FLAG_COMPUTE;
+    };
+
+    // F32 add node writing into foreign scratch.
+    auto make_add = [&](ggml_tensor * out, ggml_tensor * a, ggml_tensor * b, size_t off) {
+        set_scratch(out, GGML_TYPE_F32, off);
+        out->op = GGML_OP_ADD;
+        out->src[0] = a;
+        out->src[1] = b;
+        out->flags |= GGML_TENSOR_FLAG_COMPUTE;
+    };
+
+    // Final in-place node: the result is a view of the foreign tensor.
+    // CPY writes into src[1], which must be the node itself here.
+    auto make_result = [&](ggml_tensor * node, ggml_op op, ggml_tensor * s0, ggml_tensor * s1) {
+        ggml_cuda_ar_foreign_reset(node);
+        node->op = op;
+        node->type = t_dst;
+        for (int k = 0; k < GGML_MAX_DIMS; ++k) {
+            node->ne[k] = t_view->ne[k];
+            node->nb[k] = t_view->nb[k];
+        }
+        node->src[0] = s0;
+        node->src[1] = (op == GGML_OP_CPY) ? node : s1;
+        node->view_src = t_view;
+        node->view_offs = 0;
+        node->flags |= GGML_TENSOR_FLAG_COMPUTE;
+        ggml_backend_view_init(node);
+    };
+
+    // --- Stage 1, local rank (same as the homogeneous copy-engine path) ---
+    ggml_cuda_set_device(p->devices[L]);
+    ggml_backend_cuda_context * cuda_ctx_L =
+        static_cast<ggml_backend_cuda_context *>(backends[L]->context);
+    GGML_ASSERT(cuda_ctx_L->device == p->devices[L]);
+    if (ggml_cuda_ar_debug) {
+        const cudaError_t sticky = cudaGetLastError();
+        GGML_LOG_DEBUG("%s: L=%d F=%d slot=%d call_count=%llu compute=[%d,%d] t_src=%d t_dst=%d "
+                       "ne=%lld nbytes=%zu chunk_bytes=%zu copy_chunks=%zu slice_off=%zu "
+                       "src_buf[L]=%p host_large[L]=%p streams[L]=%p dev[L]=%d sticky=%s\n",
+                       __func__, L, F, slot, (unsigned long long) p->call_count,
+                       (int) compute[L], (int) compute[F], (int) t_src, (int) t_dst,
+                       (long long) ne, nbytes, chunk_bytes, copy_chunks, slice_off,
+                       (const void *) src_buf[L], (const void *) p->host_large[L].host,
+                       (const void *) p->streams[L], p->devices[L],
+                       sticky == cudaSuccess ? "none" : cudaGetErrorString(sticky));
+    }
+    ggml_cuda_ar_wait_for_compute(p, cuda_ctx_L, L, slot);
+    if (p->host_large_read_done_valid) {
+        // Foreign rank finished reading host_large[L] in the previous AR.
+        ggml_backend_event_synchronize(p->ev_f_read_done);
+    }
+    if (!compute[L]) {
+        CUDA_CHECK(cudaMemsetAsync(src_buf[L], 0, nbytes, p->streams[L]));
+    }
+    if (ggml_cuda_ar_debug) {
+        cudaPointerAttributes pa_src, pa_dst;
+        const cudaError_t rc_src = cudaPointerGetAttributes(&pa_src, src_buf[L]);
+        const cudaError_t rc_dst = cudaPointerGetAttributes(&pa_dst, p->host_large[L].host);
+        GGML_LOG_DEBUG("%s: ptr_attrs src: rc=%s type=%d dev=%d | dst: rc=%s type=%d dev=%d\n",
+                       __func__,
+                       rc_src == cudaSuccess ? "ok" : cudaGetErrorString(rc_src),
+                       (int) pa_src.type, pa_src.device,
+                       rc_dst == cudaSuccess ? "ok" : cudaGetErrorString(rc_dst),
+                       (int) pa_dst.type, pa_dst.device);
+    }
