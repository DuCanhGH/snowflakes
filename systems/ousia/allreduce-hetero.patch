+bool ggml_cuda_ar_launch_chunked(ggml_backend_t backend, bool compute,
+        ggml_type dst_type, ggml_type wire_type,
+        const void * data, void * host_mine, const void * host_peer,
+        int * arrival_mine, int * arrival_peer, int count, int token) {
+    ggml_backend_cuda_context * ctx = static_cast<ggml_backend_cuda_context *>(backend->context);
+    ggml_cuda_set_device(ctx->device);
+    cudaStream_t stream = ctx->stream();
+
+    // Inactive shard contributes zeros.
+    if (!compute) {
+        const size_t dst_bytes = (size_t) count * ggml_type_size(dst_type);
+        CUDA_CHECK(cudaMemsetAsync(const_cast<void *>(data), 0, dst_bytes, stream));
+    }
+
+#define GGML_CUDA_AR_LAUNCH(T_dst, T_wire) \
+        ggml_cuda_ar_kernel<T_dst, T_wire><<<dim3(GGML_CUDA_AR_KERNEL_BLOCKS), dim3(256), 0, stream>>>( \
+            reinterpret_cast<const T_dst *>(data), \
+            reinterpret_cast<T_dst *>(const_cast<void *>(data)), \
+            reinterpret_cast<T_wire *>(host_mine), \
+            reinterpret_cast<const T_wire *>(host_peer), \
+            count, arrival_mine, arrival_peer, token)
+
+    bool ok = true;
+    if (dst_type == GGML_TYPE_F32 && wire_type == GGML_TYPE_F32) {
+        GGML_CUDA_AR_LAUNCH(float, float);
+    } else if (dst_type == GGML_TYPE_F16 && wire_type == GGML_TYPE_F16) {
+        GGML_CUDA_AR_LAUNCH(half, half);
+    } else if (dst_type == GGML_TYPE_BF16 && wire_type == GGML_TYPE_BF16) {
+        GGML_CUDA_AR_LAUNCH(nv_bfloat16, nv_bfloat16);
+    } else if (dst_type == GGML_TYPE_F32 && wire_type == GGML_TYPE_BF16) {
+        GGML_CUDA_AR_LAUNCH(float, nv_bfloat16);
+    } else {
+        ok = false;
+    }
+#undef GGML_CUDA_AR_LAUNCH
+
+    if (ok && cudaGetLastError() != cudaSuccess) {
+        ok = false;
+    }
+    return ok;
+}
+
+void ggml_cuda_ar_selftest_kernel(ggml_backend_t backend, int mode,
+        void * payload, int * flag, int * result, int count, int token) {
+    ggml_backend_cuda_context * ctx = static_cast<ggml_backend_cuda_context *>(backend->context);
+    ggml_cuda_set_device(ctx->device);
+    cudaStream_t stream = ctx->stream();
+    if (mode == 0) {
+        ggml_cuda_ar_selftest_publish<<<1, 1, 0, stream>>>((uint8_t *) payload, flag, count, token);
+    } else {
+        ggml_cuda_ar_selftest_consume<<<1, 1, 0, stream>>>((const uint8_t *) payload, flag, result, count, token);
+    }
+    (void) cudaGetLastError();
+}
+
+// Probe cross-runtime visibility through the dual-mapped host memory before
+// enabling the chunked path.  Exchanges a bounded payload+flag in both
+// directions (the exact mechanism the chunked kernel relies on).  Returns
+// false -- and the caller falls back to the copy-engine path -- on any
+// mismatch, timeout, or mapping failure.
+static bool ggml_cuda_ar_hetero_selftest(ggml_cuda_ar_pipeline * p, ggml_backend_t * backends) {
+    const int L = 1 - p->foreign_rank;
+    ggml_backend_t lb = backends[L];
+    ggml_backend_t fb = p->foreign_backend;
+
+    const int    count       = 1024;
+    const size_t flag_stride = GGML_CUDA_AR_ARRIVAL_STRIDE;
+    int *        result_host = reinterpret_cast<int *>(p->arrival_hetero.host + flag_stride);
+
+    // Same physical pages, per-runtime device mappings.
+    uint8_t * payload_L = (uint8_t *) p->host_buf_hetero[L].dev[0];
+    uint8_t * payload_F = (uint8_t *) p->host_buf_hetero[L].dev[1];
+    int * flag_L   = (int *) p->arrival_hetero.dev[0];
+    int * flag_F   = (int *) p->arrival_hetero.dev[1];
+    int * result_L = (int *) (static_cast<uint8_t *>(p->arrival_hetero.dev[0]) + flag_stride);
+    int * result_F = (int *) (static_cast<uint8_t *>(p->arrival_hetero.dev[1]) + flag_stride);
+
+    ggml_backend_cuda_context * lctx = static_cast<ggml_backend_cuda_context *>(lb->context);
+
+    int token = 1;
+    for (int it = 0; it < 32; ++it) {
+        // Vary the payload offset over the two slots to exercise more than one.
+        const size_t off = (it % GGML_CUDA_AR_POOL_SIZE) * p->buf_bytes;
+
+        // L -> F: L publishes, F consumes.
+        ggml_cuda_ar_selftest_kernel(lb, 0, payload_L + off, flag_L, result_L, count, token);
+        ggml_cuda_set_device(lctx->device);
+        CUDA_CHECK(cudaStreamSynchronize(lctx->stream()));
+        p->launch_selftest(fb, 1, payload_F + off, flag_F, result_F, count, token);
+        ggml_backend_synchronize(fb);
+        if (*result_host != 1) {
+            GGML_LOG_INFO("%s: self-test L->F failed (result=%d)\n", __func__, *result_host);
+            return false;
+        }
+        token++;
+
+        // F -> L: F publishes, L consumes.
+        p->launch_selftest(fb, 0, payload_F + off, flag_F, result_F, count, token);
+        ggml_backend_synchronize(fb);
+        ggml_cuda_ar_selftest_kernel(lb, 1, payload_L + off, flag_L, result_L, count, token);
+        ggml_cuda_set_device(lctx->device);
+        CUDA_CHECK(cudaStreamSynchronize(lctx->stream()));
+        if (*result_host != 1) {
+            GGML_LOG_INFO("%s: self-test F->L failed (result=%d)\n", __func__, *result_host);
+            return false;
+        }
+        token++;
+    }
+    return true;
+}
